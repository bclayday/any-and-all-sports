# Google OAuth (required for sign-in)
# Get credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Set to "1" when Google OAuth is properly configured (enables sign-in buttons)
NEXT_PUBLIC_AUTH_PROVIDER_GOOGLE=

# NextAuth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# GitHub Data Store (optional - for party data persistence)
GITHUB_DATA_TOKEN=
GITHUB_DATA_REPO=

# Watch Party APIs (optional - for fetching real events)
EVENTBRITE_API_KEY=
MEETUP_API_KEY=
